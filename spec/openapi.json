{
  "openapi": "3.0.3",
  "info": {
    "title": "Transformers: Forged to Fight - Sparx Protocol Specification",
    "version": "9.2.0",
    "description": "Specification of the Sparx RPC protocol for Transformers: Forged to Fight v9.2.0 reverse-engineered from libil2cpp and network dumps."
