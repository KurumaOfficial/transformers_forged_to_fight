  "paths": {
    "/auth/init": {
      "post": {
        "summary": "Initialize anonymous session",
        "responses": {
          "200": {
            "description": "Successful Sparx RPC Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ts",
                    "result"
                  ],
                  "properties": {
                    "ts": {
                      "type": "integer",
                      "description": "Server epoch timestamp"
                    },
                    "result": {
                      "type": "object",
                      "required": [
                        "status",
                        "session"
                      ],
                      "properties": {
                        "status": {
                          "type": "string"
                        },
                        "session": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-required-client-fields": [
          "session"
        ],
        "x-client-error-reaction": "Fatal bootflow alert; cannot proceed without session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "api": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
